#!/bin/bash
# High Density Terminal Panel Construction Layer

set -e

declare -r TMUX_SESSION_NAME="masami_matrix"
declare -r NETWORK_INTERFACE_TARGET="${1:-eth0}"

verify_environment_dependencies() {
    echo "[SYSTEM CONFIG] Verifying local development package states..."
    for application_binary in tmux g++ go python3; do
        if ! command -v "$application_binary" &> /dev/null; then
            echo "[FATAL INITIALIZATION ERROR] Missing dependency: $application_binary" >&2
            exit 1
        fi
    done
    echo "[SYSTEM CONFIG] Dependencies verified. Initializing hardware assembly compilation parameters..."
}

compile_system_source_trees() {
    echo "[COMPILER] Translating C++ Interceptor Engine Core Architecture..."
    g++ -O3 -std=c++17 sniffer.cpp -o sniffer -lpcap

    echo "[COMPILER] Assembling Go Concurrent Ingestion Pipeline Process Tree..."
    go build -o processor processor.go
    
    echo "[SUCCESS] Compilation modules successfully translated into optimized machine code."
}

orchestrate_terminal_grid_layout() {
    if tmux has-session -t "$TMUX_SESSION_NAME" 2>/dev/null; then
        echo "[WARN] Destroying legacy active tmux operational session grids..."
        tmux kill-session -t "$TMUX_SESSION_NAME"
    fi

    echo "[WORKSPACE] Spawning multi pane multiplexed layout view panels..."
    tmux new-session -d -s "$TMUX_SESSION_NAME" -n "WiredConsole"
    
    # Slice display real estate into dedicated, operational terminal windows
    tmux split-window -h -t "$TMUX_SESSION_NAME"
    tmux split-window -v -t "$TMUX_SESSION_NAME:0.1"
    
    # Allocate dedicated execution commands into unique panel sectors
    tmux send-keys -t "$TMUX_SESSION_NAME:0.0" "sudo ./sniffer $NETWORK_INTERFACE_TARGET | ./processor" C-m
    tmux send-keys -t "$TMUX_SESSION_NAME:0.1" "sudo ./sniffer $NETWORK_INTERFACE_TARGET | python3 analyzer.py" C-m
    tmux send-keys -t "$TMUX_SESSION_NAME:0.2" "tail -f /var/log/syslog" C-m

    tmux select-pane -t "$TMUX_SESSION_NAME:0.0"
    tmux attach-session -t "$TMUX_SESSION_NAME"
}

main() {
    verify_environment_dependencies()
    compile_system_source_trees()
    orchestrate_terminal_grid_layout()
}

main "$@"
